# Canonical site URL (metadata, sitemap). On Vercel, VERCEL_URL is used automatically if unset.
# Set when using a custom domain or to lock preview to production:
# SITE_URL=https://fable-face-paint.vercel.app

# --- Sanity API → CORS origins (fixes “Failed to fetch” / SanityLive in Presentation) ---
# Add the EXACT origin you open in the browser (scheme + host + port, no path, no trailing slash), e.g.:
#   https://fable-face-paint.vercel.app
#   http://192.168.0.196:3000
#   http://localhost:3000
# Dashboard: https://sanity.io/manage/project/g7jqwqtw/api → CORS origins.
# Project also allows http://localhost:3000 and http://127.0.0.1:3000 (Sanity Live / draft preview).
# One-click for LAN dev (edit if your IP/port differs):
#   https://sanity.io/manage/project/g7jqwqtw/api?cors=add&origin=http%3A%2F%2F192.168.0.196%3A3000

# Optional: set to 0 to turn off browser live updates (no CORS needed for /data/live); server preview still works.
# SANITY_LIVE_BROWSER=0

# Required for Presentation / draft preview (Viewer token from sanity.io/manage → API → Tokens).
# Next.js reads .env.local from this folder (fable-face-paint-frontend/), not the repo root.
SANITY_API_READ_TOKEN=
# If draft-mode/enable returns 502 with EAI_AGAIN, the Next.js host cannot resolve *.api.sanity.io — fix DNS on that machine, then optionally raise retries (default 5):
# SANITY_PREVIEW_VALIDATE_MAX_ATTEMPTS=8
# Alternatives (if your tooling uses a different name):
# SANITY_READ_TOKEN=
# SANITY_API_TOKEN=

# URL where Studio runs (Visual Editing / stega links). Local: http://HOST:3333. Deployed Studio:
# NEXT_PUBLIC_SANITY_STUDIO_URL=https://fable-face-paint.sanity.studio
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# Hostname(s) allowed to load Next dev /_next assets when Studio runs on another origin (comma-separated, no protocol)
NEXT_DEV_ALLOWED_ORIGINS=192.168.0.196

# Optional extra CSP frame-ancestors (comma-separated origins) if Studio runs on a custom host/port, e.g.:
# SANITY_FRAME_ANCESTORS=http://192.168.0.196:3333
